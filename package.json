{
  "name": "origen-family-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "mobile": "npm --prefix mobile start",
    "mobile:web": "npm --prefix mobile run web",
    "start": "node server/index.mjs",
    "db:migrate": "node server/migrate.mjs",
    "db:grant-runtime": "node scripts/provision-database-runtime.mjs",
    "db:grant-maintenance": "node scripts/provision-database-maintenance.mjs",
    "db:check-maintenance": "node scripts/check-database-maintenance.mjs",
    "db:grant-telemetry-erasure": "node scripts/provision-telemetry-erasure.mjs",
    "test:observability": "node --test --test-concurrency=1 ops/observability/*.test.mjs",
    "ops:diagnostic-rehearsal": "node ops/observability/rehearsal.mjs",
    "telemetry:monitor": "node ops/observability/monitor.mjs",
    "test:diagnostic-agent": "node --test ops/diagnostic-agent/*.test.mjs",
    "test:diagnostic-runner": "node --test ops/diagnostic-runner/contracts.test.mjs",
    "test:diagnostic-isolation": "node --test --test-concurrency=1 ops/diagnostic-runner/isolation.test.mjs",
    "agent:runner": "node ops/diagnostic-runner/cli.mjs",
    "agent:pack-release": "node ops/diagnostic-runner/pack.mjs",
    "agent:broker": "node ops/diagnostic-agent/cli.mjs",
    "agent:synthetic": "node ops/diagnostic-agent/demo.mjs",
    "agent:audit": "node ops/diagnostic-agent/audit.mjs",
    "agent:retention": "node ops/diagnostic-agent/retention.mjs",
    "test:support": "node --test server/support-diagnostics.test.mjs ops/diagnostics-gateway/*.test.mjs",
    "support:gateway": "node ops/diagnostics-gateway/service.mjs",
    "support:incident": "node ops/diagnostics-gateway/create-incident.mjs",
    "support:restore-reset": "node ops/diagnostics-gateway/reset-after-restore.mjs",
    "db:grant-support-resolver": "node scripts/provision-support-resolver.mjs",
    "telemetry:ingest": "node ops/observability/ingest.mjs",
    "telemetry:erasure": "node ops/observability/erasure-worker.mjs",
    "telemetry:retention": "node ops/observability/retention.mjs",
    "telemetry:health": "node ops/observability/health.mjs",
    "db:check-runtime": "node scripts/check-database-runtime.mjs",
    "check:production": "node server/production-config.mjs",
    "check:logging": "node scripts/check-logging-policy.mjs",
    "coordinator:verify": "node scripts/verify-coordinator-release.mjs",
    "coordinator:readiness": "node ops/coordinator-readiness.mjs",
    "coordinator:stress": "node ops/coordinator-registration-stress.mjs",
    "test": "node --test server/*.test.mjs",
    "eval:contracts": "node server/model-evaluation.mjs contracts",
    "eval:personalization": "node scripts/evaluate-personalization.mjs",
    "eval:review": "node server/model-evaluation.mjs review",
    "eval:compare": "node server/model-evaluation.mjs compare",
    "research:sandbox": "node research/sandbox/demo.mjs",
    "ops:readiness": "node ops/readiness.mjs",
    "ops:rehearse": "node ops/recovery-rehearsal.mjs",
    "test:ops": "node --test ops/*.test.mjs",
    "eval:feedback": "node scripts/evaluate-feedback.mjs",
    "check:onboarding": "node scripts/check-onboarding.mjs",
    "eval:history-retrieval": "node scripts/evaluate-history-retrieval.mjs",
    "db:check-retrieval": "node scripts/check-history-retrieval.mjs",
    "eval:personalization:release": "node scripts/personalization-release.mjs",
    "test:personalization": "node --test --test-concurrency=1 server/student-memory.test.mjs server/history-retrieval.test.mjs server/live-memory.test.mjs server/adaptive-guidance.test.mjs server/personalization-controls.test.mjs server/personalization-release.test.mjs server/personalization-migrations.test.mjs server/voice-startup.test.mjs server/binder-jobs.test.mjs",
    "test:voice-infrastructure": "node --test --test-concurrency=1 server/voice-startup.test.mjs server/binder-jobs.test.mjs"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.28.0",
    "animejs": "^4.5.0",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "pg-mem": "^3.0.14",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
